# Set default behavior to automatically normalize line endings
* text=auto

# Keep text files with LF in repository, check out as LF/native without conversion warnings
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
